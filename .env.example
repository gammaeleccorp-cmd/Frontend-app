# Use the supported production API contract.
VITE_USE_MOCK_API=false

# Django/DRF base URL. No trailing slash.
VITE_API_BASE_URL=https://api.gamma-tech.ir

# API paths are centralized in src/config/endpoints.js.

# Optional official support channels shown in Profile > Support.
# Leave empty until real contact details exist; the app then says so instead of inventing any.
VITE_SUPPORT_PHONE=
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_URL=
VITE_SUPPORT_HOURS=
